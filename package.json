{
  "name": "tinytavern",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "bun scripts/watch-server.ts",
    "dev:client": "bun --bun run --cwd client dev",
    "build": "bun --bun run --cwd client build",
    "check": "bun --bun run --cwd server check && bun --bun run --cwd client check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun tests/run.ts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "@tinytavern/shared": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
