{
  "name": "tinytavern",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "node --watch server/src/index.ts",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "check": "npm run check -w server && npm run check -w client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tests/run.ts"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "prettier": "^3.9.5"
  }
}
